{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "externa-core",
    "private": true,
    "version": "1.3.0",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "a11y:contrast": "node scripts/a11y-contrast.mjs",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix && node scripts/check-ui-tokens.mjs",
        "lint:check": "eslint . --max-warnings=0 && node scripts/check-ui-tokens.mjs",
        "lint:i18n": "eslint resources/js --format json --rule '{\"i18next/no-literal-string\": [\"warn\", {\"mode\": \"jsx-text-only\"}]}' | node scripts/qiick-ratchet.mjs lint --rule i18next/no-literal-string --baseline i18n-literal-baseline.json",
        "knip": "knip",
        "lint:ui-tokens": "node scripts/check-ui-tokens.mjs",
        "prepare": "node --input-type=commonjs -e \"const fs=require('fs'); if (fs.existsSync('.git')) { require('child_process').execSync('lefthook install', {stdio:'inherit'}) }\"",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^24.19.2",
        "@types/sortablejs": "^1.15.9",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsdom": "^29.1.1",
        "knip": "^6.44.2",
        "lefthook": "^2.2.2",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@inertiajs/react": "^2.3.29",
        "@laravel/passkeys": "^0.4.0",
        "@shadcn/react": "^0.3.1",
        "@tailwindcss/vite": "^4.3.4",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/extension-link": "^3.31.3",
        "@tiptap/extension-placeholder": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/react": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@uiw/codemirror-theme-vscode": "^4.25.12",
        "@uiw/react-codemirror": "^4.25.12",
        "@uiw/react-md-editor": "^4.2.3",
        "@vitejs/plugin-react": "^6.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "concurrently": "^10.0.5",
        "country-flag-icons": "^1.6.20",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "globals": "^17.14.0",
        "i18next": "^26.7.1",
        "input-otp": "^1.5.0",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^3.2.1",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.69.0",
        "pusher-js": "^8.6.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.12",
        "react-markdown": "^10.1.0",
        "recharts": "^3.10.1",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.6.0",
        "sonner": "^2.0.8",
        "sortablejs": "^1.15.7",
        "streamdown": "^2.7.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vaul": "^1.1.2",
        "vite": "^8.3.6",
        "zustand": "^5.0.16"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.63.4",
        "@rollup/rollup-win32-x64-msvc": "4.63.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
