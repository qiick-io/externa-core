{
  "name": "@qiick/externa-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Externa Public CMS API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiick-io/externa-core.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "check:fresh": "node ./scripts/check-fresh.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "check": "npm run check:fresh && npm run types:check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
