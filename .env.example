APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis (required for Horizon / Reverb presence / Pulse redis ingest)
# Herd: enable Redis, then use these defaults.
# Without Redis: keep QUEUE_CONNECTION=database and BROADCAST_CONNECTION=log.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PULSE_DB=2

# -----------------------------------------------------------------------------
# Queues — minimal vs full stack
# Minimal (no Redis): QUEUE_CONNECTION=database + `php artisan queue:listen`
# Full (Herd Redis):  QUEUE_CONNECTION=redis + `php artisan horizon`
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
# QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Broadcasting — minimal vs full stack
# Minimal: BROADCAST_CONNECTION=log (UI falls back to 60s notification poll)
# Full:    BROADCAST_CONNECTION=reverb + WebSocket server
#
# Herd Pro Reverb (recommended locally — service on :8080):
#   Use the credentials below (from Herd → Services → Reverb).
#   Host for Echo/clients must be 127.0.0.1 or localhost (not 0.0.0.0).
#   After changing VITE_REVERB_*: rebuild (`npm run build` or restart `npm run dev`).
#
# Standalone: `php artisan reverb:start` — then set your own APP_ID/KEY/SECRET
#   in both this app and the process that starts Reverb (same values).
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
# BROADCAST_CONNECTION=log

REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-herd
REVERB_APP_SECRET=secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Pulse — optional; disable with PULSE_ENABLED=false
# Prefer redis ingest + `php artisan pulse:work` when Redis is available.
# -----------------------------------------------------------------------------
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=pulse
PULSE_STORAGE_KEEP="2 days"
PULSE_INGEST_KEEP="2 days"
# Essential recorders (others default off in config/pulse.php):
# PULSE_EXCEPTIONS_ENABLED=true
# PULSE_QUEUES_ENABLED=true
# PULSE_SLOW_JOBS_ENABLED=true
# PULSE_SLOW_QUERIES_ENABLED=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Files: max bytes for synchronous single-file duplicate (default 50MB)
FILES_DUPLICATE_SYNC_MAX_BYTES=52428800
FILES_ZIP_TTL_MINUTES=60
FILES_ZIP_MAX_BYTES=104857600

# AI (LM Studio / OpenAI-compatible local gateway)
AI_DEFAULT_PROVIDER=local
LOCAL_AI_URL=http://127.0.0.1:1234/v1
LOCAL_AI_API_KEY=
# Prefer a model with reliable tool-calling (tiny models often hallucinate success).
LOCAL_AI_MODEL=openai/gpt-oss-20b
AI_REMOTE_IMPORT_HOSTS=
AI_WEBHOOK_TOKEN=
AI_DAILY_PROMPT_LIMIT=0
AI_EMBEDDINGS_ENABLED=false
AI_MCP_ENABLED=false
