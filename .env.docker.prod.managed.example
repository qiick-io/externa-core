APP_NAME=Externa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://externa.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Managed / external database (RDS, Cloud SQL, Neon, etc.)
DB_CONNECTION=pgsql
DB_HOST=db.example.com
DB_PORT=5432
DB_DATABASE=externa
DB_USERNAME=externa
DB_PASSWORD=change-me

# Managed / external Redis (ElastiCache, Upstash, Memorystore, …)
REDIS_CLIENT=phpredis
REDIS_HOST=redis.example.com
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_PULSE_DB=2

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Behind TLS-terminating proxy:
# TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
FILES_DISK=s3
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=1001
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=externa.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

APP_PORT=8080
REVERB_HOST_PORT=8081
RUN_MIGRATIONS=true
CACHE_CONFIG=true

PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=externa
AWS_USE_PATH_STYLE_ENDPOINT=false
