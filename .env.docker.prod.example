APP_NAME=Externa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://externa.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=externa
DB_USERNAME=externa
DB_PASSWORD=change-me

# External managed DB: set DB_HOST to the provider hostname and remove the
# compose `pgsql` service (or use profile managed — see issue #15).

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Behind TLS-terminating proxy:
# TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
FILES_DISK=s3
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_PULSE_DB=2

REVERB_APP_ID=1001
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
# Public host/port clients use (proxy):
REVERB_HOST=externa.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=pulse

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=externa
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# First boot: migrate on app start. Seed/admin only when RUN_SEED=true (then set false).
RUN_MIGRATIONS=true
RUN_SEED=false
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=

CACHE_CONFIG=true
APP_PORT=8080
REVERB_HOST_PORT=8081

# Optional GHCR image pin when using compose.quick.yaml:
# EXTERNA_IMAGE=ghcr.io/qiick-io/externa-core:1.0.0-beta.4
