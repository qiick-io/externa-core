# Minimal env for compose.quick.yaml (GHCR pull path).
# Copy → .env, fill blanks, then: docker compose -f compose.quick.yaml up -d

APP_NAME=Externa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=externa
DB_USERNAME=externa
DB_PASSWORD=change-me

# First boot: migrate on app start. Seed/admin only when RUN_SEED=true.
# After first successful login, set RUN_SEED=false (keep or drop RUN_MIGRATIONS).
RUN_MIGRATIONS=true
RUN_SEED=false

# Required when RUN_SEED=true — strong password before first boot.
INITIAL_SUPER_ADMIN_FIRST_NAME=Super
INITIAL_SUPER_ADMIN_LAST_NAME=Admin
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_PULSE_DB=2

REVERB_APP_ID=1001
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
# Browser-facing host (localhost for bare publish; your domain behind TLS proxy):
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=pulse

FILESYSTEM_DISK=local
FILES_DISK=assets

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Behind TLS-terminating proxy (#17):
# TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE=true
# APP_URL=https://externa.example.com

APP_PORT=8080
REVERB_HOST_PORT=8081

# Optional: pin / override image (default ghcr.io/qiick-io/externa-core:latest)
# EXTERNA_IMAGE=ghcr.io/qiick-io/externa-core:1.0.0-beta.4
